<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: облачная копия Google и перенос при настройке нового телефона. См. backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="covers/" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="covers/" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
