<?xml version="1.0" encoding="utf-8"?>
<!--
  Системная резервная копия Android (Google, Android 11 и ниже — это правило; 12+ — data_extraction_rules).
  База целиком (вместе с журналом -wal: иначе последние изменения Room могли бы не попасть в копию),
  обложки и настройки. Локальные автокопии и очередь плеера не копируются (лимит 25 МБ).
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="covers/" />
    <include domain="file" path="datastore/" />
</full-backup-content>
